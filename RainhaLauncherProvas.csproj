<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\rainha.ico</ApplicationIcon>
    <AssemblyName>RainhaLauncherProvas</AssemblyName>
    <Product>Rainha - Sistema de Avaliações de Excel</Product>
    <Company>Rainha</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\logo_rainha.png" LogicalName="Rainha.logo_rainha.png" />
    <EmbeddedResource Include="assets\rainha.ico" LogicalName="Rainha.rainha.ico" />
    <EmbeddedResource Include="Templates\TESTE EXCEL - APRENDIZ .xlsx" LogicalName="Rainha.Template.TESTE EXCEL - APRENDIZ .xlsx" />
    <EmbeddedResource Include="Templates\TESTE EXCEL- AUX ADMINISTRATIVO.xlsx" LogicalName="Rainha.Template.TESTE EXCEL- AUX ADMINISTRATIVO.xlsx" />
  </ItemGroup>

</Project>
